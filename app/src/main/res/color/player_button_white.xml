<?xml version="1.0" encoding="utf-8"?>
<!-- Always-white control tint (with disabled dimming) for the player's
     skip buttons, so they stay legible over the album artwork. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="@dimen/material_emphasis_disabled" android:color="@android:color/white" android:state_enabled="false" />
    <item android:color="@android:color/white" />
</selector>
